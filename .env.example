# Postgres from compose.yaml
DATABASE_URL="postgresql://mm:mm-local-pwd@localhost:5434/mm"

# Public URL of the app (used for OAuth redirects and media links)
APP_URL="http://localhost:3300"

# 32-byte hex key used to encrypt channel tokens at rest: openssl rand -hex 32
ENCRYPTION_KEY=""

# Where uploaded media is stored on disk
UPLOAD_DIR="./uploads"

# X (Twitter) OAuth 2.0 app: callback URL = $APP_URL/api/oauth/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# LinkedIn app with "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn" products
# callback URL = $APP_URL/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_API_VERSION="202509"

# Reddit "web app" from reddit.com/prefs/apps: redirect uri = $APP_URL/api/oauth/reddit/callback
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# Reddit asks for <platform>:<app id>:<version> (by /u/<your username>)
REDDIT_USER_AGENT="web:marketingmanager:0.1"

# YouTube (Google Cloud OAuth client, type "Web application", with the YouTube Data API v3 enabled)
# redirect URI = $APP_URL/api/oauth/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Bluesky, Mastodon, Telegram and Discord need no app config here: they connect with
# credentials entered on the Channels page (app password, access token, bot token, webhook URL).

# Inbox reply drafts written by the Claude CLI (Claude Code) on the worker's machine, using its login.
# Needs `claude` installed and signed in where `pnpm worker` runs. Drafts are suggestions; nothing is posted on its own.
DRAFTS_WITH_CLAUDE_CLI="false"
# Optional: path to the CLI if it isn't on PATH, and a model for drafts (e.g. "sonnet" to use less of your plan)
# CLAUDE_BIN="/home/you/.local/bin/claude"
# CLAUDE_DRAFT_MODEL="sonnet"
